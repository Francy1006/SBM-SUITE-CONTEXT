#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Uso:
  sbm qa [objective_id]
  sbm context deploy [objective_id]
  sbm context upgrade
  sbm documentation deploy
  sbm documentation upgrade
  sbm git pull [objective_id]
  sbm git publish [objective_id]
  sbm git finalize [objective_id]
EOF
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
case "${MSYSTEM:-}" in
  MINGW*|MSYS*) PLATFORM="windows-git-bash" ;;
  *) [[ "$(uname -s)" == "Darwin" ]] && PLATFORM="macos" || PLATFORM="linux" ;;
esac

context_python() {
  local candidate
  for candidate in \
    "${ROOT}/.venv/Scripts/python.exe" \
    "${ROOT}/.venv/Scripts/python3.exe" \
    "${ROOT}/.venv/bin/python3" \
    "${ROOT}/.venv/bin/python"
  do
    if [[ -x "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  echo "ERROR: Context requiere su Python en .venv" >&2
  return 1
}

[[ "${1:-}" == "--help" || "${1:-}" == "-h" ]] && { usage; exit 0; }
CONTEXT_PYTHON="$(context_python)"
RUNTIME_DIR=""
cleanup() {
  [[ -z "${RUNTIME_DIR}" || ! -d "${RUNTIME_DIR}" ]] || rm -rf -- "${RUNTIME_DIR}"
}
trap cleanup EXIT

if [[ "${PLATFORM}" == "windows-git-bash" && "${CONTEXT_PYTHON}" == *.exe ]]; then
  RUNTIME_DIR="$(mktemp -d)"
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "${CONTEXT_PYTHON}" > "${RUNTIME_DIR}/python3"
  chmod +x "${RUNTIME_DIR}/python3"
  export PATH="${RUNTIME_DIR}:${PATH}"
else
  export PATH="$(dirname "${CONTEXT_PYTHON}"):${PATH}"
fi

resolve_active() {
  local args=(--project-context "${ROOT}/PROJECT_CONTEXT.md")
  [[ -z "${1:-}" ]] || args+=(--objective-id "$1")
  "${CONTEXT_PYTHON}" "${ROOT}/scripts/sbm-cli.py" "${args[@]}"
}

load_active() {
  local active_values
  active_values="$(resolve_active "${1:-}")"
  IFS=$'\t' read -r OBJECTIVE_ID OBJECTIVE_BRANCH OBJECTIVES_JSON <<< "${active_values}"
}

[[ "$#" -ge 1 ]] || { usage >&2; exit 2; }
COMMAND="$1${2:+ $2}"
[[ "$1" != "qa" ]] || COMMAND="qa"
case "${COMMAND}" in
  "qa")
    [[ "$#" -ge 1 && "$#" -le 2 ]] || { usage >&2; exit 2; }
    load_active "${2:-}"
    bash "${ROOT}/QA/qa-full.sh" \
      --branch "${OBJECTIVE_BRANCH}" \
      --objectives-json "${OBJECTIVES_JSON}" \
      --sonarqube-ready
    ;;
  "context deploy")
    [[ "$#" -ge 2 && "$#" -le 3 ]] || { usage >&2; exit 2; }
    load_active "${3:-}"
    bash "${ROOT}/scripts/context-deploy.sh" implementation-progress "${OBJECTIVES_JSON}"
    ;;
  "context upgrade")
    [[ "$#" == 2 ]] || { usage >&2; exit 2; }
    bash "${ROOT}/scripts/context-upgrade.sh"
    ;;
  "documentation deploy")
    [[ "$#" == 2 ]] || { usage >&2; exit 2; }
    bash "${ROOT}/scripts/documentation-deploy.sh"
    ;;
  "documentation upgrade")
    [[ "$#" == 2 ]] || { usage >&2; exit 2; }
    bash "${ROOT}/scripts/documentation-upgrade.sh"
    ;;
  "git pull")
    [[ "$#" -ge 2 && "$#" -le 3 ]] || { usage >&2; exit 2; }
    load_active "${3:-}"
    bash "${ROOT}/scripts/objective-git-pull.sh" "${OBJECTIVE_ID}"
    ;;
  "git publish")
    [[ "$#" -ge 2 && "$#" -le 3 ]] || { usage >&2; exit 2; }
    load_active "${3:-}"
    bash "${ROOT}/scripts/objective-git-publish.sh" "${OBJECTIVE_ID}"
    ;;
  "git finalize")
    [[ "$#" -ge 2 && "$#" -le 3 ]] || { usage >&2; exit 2; }
    load_active "${3:-}"
    bash "${ROOT}/scripts/objective-git-finalize.sh" \
      "${OBJECTIVE_ID}" "${OBJECTIVE_BRANCH}"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
